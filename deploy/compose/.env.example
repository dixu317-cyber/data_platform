# Copy this file to deploy/compose/.env, replace every CHANGE_ME value, and keep
# the result outside git. Password values are embedded in PostgreSQL URLs, so use
# URL-safe random strings (letters, numbers, '-', '_') rather than raw ':'/'@'.
# The template intentionally expands with `docker compose config`, but up.sh
# refuses to start if a required CHANGE_ME / factory token remains.

# Local tags for images built from the source ZIP. They are not registry coordinates.
FF_IMAGE_PREFIX=ff-companybrain
FF_IMAGE_TAG=latest
WEB_HOST_PORT=3000

# Local-only observation ports. `up.sh build` loads compose.dev-ports.yml
# automatically. Keep the 127.0.0.1 binding in that YAML; changing these
# values does not expose PostgreSQL or Neo4j to the LAN.
POSTGRES_DEV_HOST_PORT=15432
NEO4J_HTTP_DEV_HOST_PORT=17474
NEO4J_BOLT_DEV_HOST_PORT=17687

# PostgreSQL bootstrap, migrator, and six least-privilege runtime role passwords.
POSTGRES_BOOTSTRAP_USER=postgres
POSTGRES_BOOTSTRAP_PASSWORD=CHANGE_ME_POSTGRES_BOOTSTRAP_PASSWORD
POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME_POSTGRES_MIGRATOR_PASSWORD
IDENTITY_APP_PASSWORD=CHANGE_ME_IDENTITY_APP_PASSWORD
PLATFORM_APP_PASSWORD=CHANGE_ME_PLATFORM_APP_PASSWORD
NANO_APP_PASSWORD=CHANGE_ME_NANO_APP_PASSWORD
AGENT_APP_PASSWORD=CHANGE_ME_AGENT_APP_PASSWORD
TRADITIONAL_APP_PASSWORD=CHANGE_ME_TRADITIONAL_APP_PASSWORD
GRAPH_APP_PASSWORD=CHANGE_ME_GRAPH_APP_PASSWORD

# First administrator and Neo4j. Do not retain these template values in .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

# The exact factory token is deliberately rejected by every runtime service.
# Use a random value at least 32 characters long.
RAG_INTERNAL_TOKEN=change-me-internal-token

# Required embedding and Agent/Graph LLM credentials. These are not validated as
# successful SaaS calls until M5; they still must be supplied for a real delivery.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=CHANGE_ME_EMBEDDING_API_KEY
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1024
CHUNK_TOKEN_MODE=0
AGENT_PROVIDER=openai-compatible
AGENT_BASE_URL=https://openrouter.ai/api/v1
AGENT_API_KEY=CHANGE_ME_AGENT_API_KEY
AGENT_MODEL=deepseek/deepseek-v4-flash
AGENT_TEMPERATURE=0
AGENT_STREAM_USAGE=false

# Optional degradation: leave DashScope empty to skip reranking; leave MinerU
# empty when the learner will not ingest PDFs (TXT/MD paths still work).
DASHSCOPE_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-rerank
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net
