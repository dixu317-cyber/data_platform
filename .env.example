# ============================================================
# FF-CompanyBrain 环境变量配置模板
# 用法：复制本文件为 .env 后填入真实值；带 <...> 的占位符必须替换。
# 安全红线：API_KEY / PASSWORD / TOKEN 只放本地 .env 或部署密钥系统，切勿提交 git。
# ============================================================

# Docker Compose 学员交付使用 deploy/compose/.env.example，而不是本文件中的 localhost
# 开发地址。Compose 模板会改用 service name、最小权限数据库角色和 fail-closed 变量检查。

# ---------- 数据库（PostgreSQL；每个模块独立 database）----------
# PostgreSQL 管理连接，scripts/init-db.ts 用它创建下面各数据库。
# macOS 上用 scripts/postgres-dev.sh 时，把 <local-user> 换成你的系统用户名。
POSTGRES_ADMIN_URL=postgres://<local-user>@localhost:5432/postgres

# 平台身份库：用户、登录、Bearer Token。由 apps/api + packages/identity 使用。
IDENTITY_DATABASE_URL=postgres://<local-user>@localhost:5432/platform_identity_db

# 平台业务库：场景 / 任务 / 知识对象 / 会话消息 / 引用 / 运行配置 / 审批 / 审计。
# 由 packages/platform 使用（P12 企业化地基改造，独立于身份库）。
PLATFORM_DATABASE_URL=postgres://<local-user>@localhost:5432/platform_core_db

# Nano Brain（后台引擎名「Gbrain」，知识页型链路）模块的独立数据库。
NANO_BRAIN_DATABASE_URL=postgres://<local-user>@localhost:5432/nano_brain_db
# Traditional RAG（后台引擎名「Naive RAG」，文档/表格/混合检索链路）模块的独立数据库。
TRADITIONAL_RAG_DATABASE_URL=postgres://<local-user>@localhost:5432/traditional_rag_db
# GraphRAG（LightRAG；PG/pgvector 支撑存储 + Neo4j graph）模块的独立数据库。
GRAPH_RAG_DATABASE_URL=postgres://<local-user>@localhost:5432/graph_rag_db

# Neo4j is the only graph backend; missing/invalid credentials fail closed.
# Real values belong in local/deployment secrets and must never be committed.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=<your-neo4j-username>
NEO4J_PASSWORD=<your-neo4j-password>
# LightRAG must use the explicit default database; do not set NEO4J_WORKSPACE.
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=10
NEO4J_CONNECTION_TIMEOUT_SECONDS=10

# Agent Gateway（会话 / run / SSE / checkpoint）数据库。
# 可与其它库共用同一 PostgreSQL 实例，但必须是独立的 database。
AGENT_DATABASE_URL=postgres://<local-user>@localhost:5432/agent_gateway_db
# LangGraph checkpoint（会话状态持久化）所用的 schema 名。
AGENT_CHECKPOINT_SCHEMA=langgraph

# ---------- 服务端口与内部调用 ----------
# 统一平台 API（apps/api）监听端口。
API_PORT=3001
# Agent Gateway（apps/agent-gateway）监听端口。
AGENT_GATEWAY_PORT=3002
# 内部 API 基地址（预留参数，当前代码未消费；供后续模块/网关回调统一 API 时使用）。
API_INTERNAL_BASE_URL=http://127.0.0.1:3001

# 统一 API 调用各 RAG 模块 HTTP 服务时携带的内部凭据。部署时必须改成非默认的强随机值。
RAG_INTERNAL_TOKEN=change-me-internal-token
# 三个 RAG 模块的 HTTP 服务端口与地址（统一 API 据此把 /nano、/traditional、/graph 请求转发到对应模块）。
# Nano Brain 模块 HTTP 服务端口。
NANO_BRAIN_HTTP_PORT=8100
# Nano Brain 模块 HTTP 服务地址（统一 API 的转发目标）。
NANO_BRAIN_HTTP_URL=http://127.0.0.1:8100
# Traditional RAG 模块 HTTP 服务端口。
TRADITIONAL_RAG_HTTP_PORT=8101
# Traditional RAG 模块 HTTP 服务地址。
TRADITIONAL_RAG_HTTP_URL=http://127.0.0.1:8101
# GraphRAG 模块 HTTP 服务端口。
GRAPH_RAG_HTTP_PORT=8102
# GraphRAG 模块 HTTP 服务地址。
GRAPH_RAG_HTTP_URL=http://127.0.0.1:8102

# ---------- 默认管理员（scripts/create-admin.ts）----------
# 首次初始化创建的管理员登录名。
ADMIN_USERNAME=admin
# 管理员登录密码（只存本地，请改成强密码，勿提交 git）。
ADMIN_PASSWORD=change-me-please

# ---------- Embedding（向量化；三条 RAG 链路共用）----------
# Embedding 提供方类型；OpenRouter 使用 OpenAI 兼容接口。
EMBEDDING_PROVIDER=openai-compatible
# Embedding API 基地址（OpenRouter OpenAI 兼容端点）。
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Embedding API 密钥。只放本地 / 密钥系统，勿提交 git。
EMBEDDING_API_KEY=<your-openrouter-api-key>
# Embedding 模型。
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# 向量维度：必须与上面模型实际输出、数据库 vector 列、检索逻辑三者严格一致。
EMBEDDING_DIMENSIONS=1024
# chunking 尺寸模式：0 = 按字符切分（当前语料评测最优基线，默认）；1 = 按 embedding 模型分词器计 token 尺寸。
# 说明：P7-A 评测显示当前语料下 token 化不优于字符基线，故默认关（=0），token 化为 opt-in。
CHUNK_TOKEN_MODE=0
# token 模式（CHUNK_TOKEN_MODE=1）使用的本地 vendored tokenizer.json 路径（离线/国内稳，零运行时联网）。
# 用 scripts/fetch-tokenizers.sh 下载；缺失则 token 模式退回字符兜底。CHUNK_TOKEN_MODE=0 时本项不生效。
EMBEDDING_TOKENIZER_PATH=assets/tokenizers/qwen3-embedding-8b/tokenizer.json

# ---------- Agent LLM（LangChain/LangGraph 智能体；也是 GraphRAG 建图抽取用的 LLM）----------
# Agent LLM 提供方类型；OpenRouter / 官方 deepseek 均走 OpenAI 兼容接口。
AGENT_PROVIDER=openai-compatible
#
# 【通道二选一】GraphRAG 建图速度对此高度敏感（I92 提速实测结论）：
#   A) OpenRouter（兼容默认）：base=https://openrouter.ai/api/v1，model 带前缀 deepseek/deepseek-v4-flash。
#      实测高并发下 OpenRouter 侧限流是天花板（16 并发出现 50+ 次 429），建图墙钟更长。
#   B) 官方 deepseek 直连（★推荐，提速方案）：base=https://api.deepseek.com/v1，model 去前缀 deepseek-v4-flash。
#      官方 flash 并发上限 2500，同并发下 429 骤降、建图墙钟快 18~34%；配合下方并发参数端到端约 2.7× 提速。
# 切换时 BASE_URL / MODEL / API_KEY 三者必须同组，不可混搭（前缀不一致会 404）。
#
# Agent LLM API 基地址。默认 OpenRouter；提速改 https://api.deepseek.com/v1。
AGENT_BASE_URL=https://openrouter.ai/api/v1
# Agent LLM 密钥（与所选 BASE_URL 同源：OpenRouter key 或 官方 deepseek key）。只放本地，勿提交 git。
AGENT_API_KEY=<your-openrouter-or-deepseek-api-key>
# Agent 用的对话/推理模型；GraphRAG 建图时抽取实体与关系也调用它。
# OpenRouter 用 deepseek/deepseek-v4-flash；官方直连用 deepseek-v4-flash（无前缀）。
AGENT_MODEL=deepseek/deepseek-v4-flash
# 采样温度：0 = 最确定（适合可复现与工具调用）。
AGENT_TEMPERATURE=0
# 是否在流式响应中返回 token 用量统计。
AGENT_STREAM_USAGE=false

# ---------- GraphRAG 建图并发（LightRAG；I92 提速核心参数）----------
# 不设置时用 LightRAG 默认 3/4，建图较慢。以下推荐值仅在【官方 deepseek 直连】通道下安全。
# 压测结论（官方通道，20 篇语料）：8/8=442s，12/12=367s，16/16≈305~344s 均 0 失败；
#   24/24 断崖崩溃（18/20 篇失败、28 次 worker 超时）。选 12/12 = 崖前留 50% 余量的稳定甜点。
# 单篇文档内实体抽取并发（MAX_PARALLEL_INSERT）。默认 3；官方通道推荐 12。
MAX_PARALLEL_INSERT=12
# LLM 抽取调用并发（MAX_ASYNC）。默认 4；官方通道推荐 12。日志中 (async: N) 标记 = 本值×2，可据此核验是否生效。
MAX_ASYNC=12

# ---------- MinerU（PDF 解析；仅 Traditional RAG 的 PDF 入库链路用）----------
# MinerU 云端解析 API 密钥（JWT，有时效会过期）。过期后 PDF 入库会静默 failed，需刷新此 key。
MINERU_API_KEY=<your-mineru-jwt>
# MinerU 服务地址：只填 host，代码自行拼接 /api/v4；切勿带 /api/v4，否则路径重复报 404。
MINERU_BASE_URL=https://mineru.net

# ---------- Rerank（全域问答检索后的相关性精排；可选）----------
# 阿里云百炼 DashScope 密钥；三路检索结果用 qwen3-rerank 打校准分 → 阈值过滤 + 取 top-N。
# 未配置时不精排，保留全部召回。
DASHSCOPE_API_KEY=<your-dashscope-api-key>
# rerank 服务端点地址（DashScope 文本精排 API）。
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# rerank 模型名。
RERANK_MODEL=qwen3-rerank
# 精排校准分阈值：低于此分的召回结果被过滤。
RERANK_MIN_SCORE=0.4
# 精排后保留的条数上限。
RERANK_TOP_N=5

# ---------- 平台运行时超时（FF_*）----------
# 全域问答中单个知识源的检索超时（毫秒）。per-source race：某个源超时即降级跳过，不拖垮整轮问答。
FF_GLOBAL_RETRIEVAL_TIMEOUT_MS=45000
# 后台「确认入库」时，platform 轮询等待 GraphRAG 单篇文档建图 ready 的超时（毫秒）。
# 实体密集文档建图较慢、可能超此值 → 前台显示超时；但模块后台仍继续建图，最终 ready 后问答可正常召回。
FF_GRAPH_DOC_TIMEOUT_MS=900000
