FROM ghcr.io/astral-sh/uv:0.9.7-python3.13-bookworm-slim AS python-base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_PROGRESS=1

FROM python-base AS traditional-rag

WORKDIR /app/traditional-rag

COPY modules/traditional-rag/pyproject.toml modules/traditional-rag/uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

COPY modules/traditional-rag/src ./src
RUN uv sync --locked --no-dev

ENV PATH="/app/traditional-rag/.venv/bin:${PATH}" \
    PYTHONPATH="/app/traditional-rag/src"

EXPOSE 8101
CMD ["python", "-m", "traditional_rag.http.main"]

FROM python-base AS graph-rag

WORKDIR /app/graph-rag

COPY modules/graph-rag/pyproject.toml modules/graph-rag/uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

COPY modules/graph-rag/src ./src
RUN uv sync --locked --no-dev

ENV PATH="/app/graph-rag/.venv/bin:${PATH}" \
    PYTHONPATH="/app/graph-rag/src"

EXPOSE 8102
CMD ["python", "-m", "graph_rag.http.main"]
